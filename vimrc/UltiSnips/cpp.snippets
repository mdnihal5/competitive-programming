snippet normal "Competitive Programming Template"

/*
        Author: md_nihal
        Created on : `!p snip.rv = __import__("datetime").datetime.now().strftime("%A %d %B %Y %I:%M:%S %p")`
*/

#include "bits/stdc++.h"
using namespace std;
#define all(x) x.begin(),x.end()
#define ALL(x) x.rbegin(),x.rend()
#define int long long
#define endl "\n" // remove this for interactive problems
const int mod = 1E9 + 7, MAX = 1E7 + 7, N = 1E5 + 5, inf = 1E18;

#ifndef DEBUG
#define debug(x...);
#else
#include "`!p snip.rv = __import__('os').path.expanduser('~/Personal/competitive-programming/Templete/debug.hpp')`"
#endif

/*=========================================== SOLUTION ===========================================*/

void ____solve() {
    ${0}
}

/*============================================= MAIN =============================================*/

int32_t main() {
    ios_base::sync_with_stdio(0);
    cin.tie(0);
    cout.tie(0);

    int Test = 1;  ${1}cin >> Test;

    for (int Case = 1; Case <= Test; Case++) {
        debug(Case);
        ____solve();
    }
}

endsnippet

snippet list "Print every available trigger + description (read live from INDEX.md)"
`!p
import re, os
bt = chr(96)  # UltiSnips ends a !p block at the next literal backtick char -- cannot write one directly here
idx = os.path.expanduser('~/Personal/competitive-programming/vimrc/UltiSnips/INDEX.md')
out = ['/*', ' * Available templates -- trigger : description (INDEX.md has full usage)']
try:
    f = open(idx)
    for raw in f:
        m_cat = re.match(r'^## (.+)', raw)
        m_trig = re.match(r'^### ' + bt + r'([^' + bt + r']+)' + bt + r'\s+—\s+(.+)', raw)
        if m_cat:
            out.append(' *')
            out.append(' * ' + m_cat.group(1).strip())
        elif m_trig:
            out.append(' *   %-20s %s' % (m_trig.group(1), m_trig.group(2).strip()))
    f.close()
except IOError:
    out.append(' * INDEX.md not found -- expected at ' + idx)
out.append(' */')
snip.rv = '\n'.join(out)
`
endsnippet

snippet nCr "nCr"
struct Fact {
    int f[N + 1], inv[N + 1];

    int pw(int a, int b) {
        int r = 1;
        while (b) {
            if (b & 1) r = 1LL * r * a % mod;
            a = 1LL * a * a % mod;
            b >>= 1;
        }
        return r;
    }

    Fact() {
        f[0] = 1;
        for (int i = 1; i <= N; i++) f[i] = 1LL * f[i - 1] * i % mod;
        inv[N] = pw(f[N], mod - 2);
        for (int i = N; i; i--) inv[i - 1] = 1LL * inv[i] * i % mod;
    }

    int ncr(int n, int r) {
        if (r < 0 || r > n || n > N) return 0;
        return 1LL * f[n] * inv[r] % mod * inv[n - r] % mod;
    }

    int npr(int n, int r) {
        if (r < 0 || r > n || n > N) return 0;
        return 1LL * f[n] * inv[n - r] % mod;
    }
} fac;
endsnippet

