snippet DSU "disjoint set union, path compression + union by size" b
struct DSU {
    vector<int> par, sz;

    DSU(int n) : par(n), sz(n, 1) { iota(par.begin(), par.end(), 0); }

    int find(int x) { return par[x] == x ? x : par[x] = find(par[x]); }

    bool unite(int x, int y) {
        x = find(x); y = find(y);
        if (x == y) return false;
        if (sz[x] < sz[y]) swap(x, y);
        par[y] = x;
        sz[x] += sz[y];
        return true;
    }

    bool connected(int x, int y) { return find(x) == find(y); }
    int compSize(int x) { return sz[find(x)]; }
};
endsnippet

snippet Dijkstra "shortest paths, non-negative weights" b
struct Dijkstra {
    int n;
    vector<vector<pair<int, int>>> adj;
    vector<int> dist;

    Dijkstra(int n) : n(n), adj(n) {}

    void addEdge(int u, int v, int w) { adj[u].push_back({v, w}); }

    void run(int src) {
        dist.assign(n, inf);
        dist[src] = 0;
        priority_queue<pair<int, int>, vector<pair<int, int>>, greater<>> pq;
        pq.push({0, src});
        while (!pq.empty()) {
            auto [d, u] = pq.top();
            pq.pop();
            if (d != dist[u]) continue;
            for (auto [v, w] : adj[u])
                if (d + w < dist[v]) pq.push({dist[v] = d + w, v});
        }
    }
};
endsnippet

snippet BellmanFord "shortest paths, negative weights + negative-cycle detection" b
struct BellmanFord {
    int n;
    vector<array<int, 3>> edges;
    vector<int> dist;
    vector<bool> poisoned;

    BellmanFord(int n) : n(n) {}

    void addEdge(int u, int v, int w) { edges.push_back({u, v, w}); }

    void run(int src) {
        dist.assign(n, inf);
        poisoned.assign(n, false);
        dist[src] = 0;
        for (int i = 0; i < n; i++)
            for (auto [u, v, w] : edges)
                if (dist[u] != inf && dist[u] + w < dist[v]) {
                    dist[v] = max(dist[u] + w, -inf);
                    if (i == n - 1) poisoned[v] = true;
                }
        for (bool changed = true; changed;) {
            changed = false;
            for (auto [u, v, w] : edges)
                if (poisoned[u] && !poisoned[v]) poisoned[v] = changed = true;
        }
        for (int v = 0; v < n; v++)
            if (poisoned[v]) dist[v] = -inf;
    }
};
endsnippet

snippet BinaryLift "LCA, kth ancestor, distance via binary lifting" b
struct BinaryLift {
    int n, lg;
    vector<int> depth;
    vector<vector<int>> adj, up;

    BinaryLift(int n) : n(n), lg(__lg(n) + 1), depth(n), adj(n), up(lg, vector<int>(n, -1)) {}

    void addEdge(int u, int v) {
        adj[u].push_back(v);
        adj[v].push_back(u);
    }

    void init(int root = -1) {
        auto dfs = [&](int r) {
            vector<int> stk = {r};
            while (!stk.empty()) {
                int u = stk.back();
                stk.pop_back();
                for (int v : adj[u])
                    if (v != up[0][u]) {
                        depth[v] = depth[u] + 1;
                        up[0][v] = u;
                        stk.push_back(v);
                    }
            }
        };
        if (root != -1) dfs(root);
        else for (int u = 0; u < n; u++) if (up[0][u] == -1) dfs(u);
        for (int i = 1; i < lg; i++)
            for (int j = 0; j < n; j++)
                up[i][j] = up[i - 1][j] == -1 ? -1 : up[i - 1][up[i - 1][j]];
    }

    int lca(int u, int v) {
        if (depth[u] < depth[v]) swap(u, v);
        u = kthAncestor(u, depth[u] - depth[v]);
        if (u == v) return u;
        for (int i = lg - 1; i >= 0; i--)
            if (up[i][u] != up[i][v]) u = up[i][u], v = up[i][v];
        return up[0][u];
    }

    int dist(int u, int v) { return depth[u] + depth[v] - 2 * depth[lca(u, v)]; }

    int kthAncestor(int u, int k) {
        if (k > depth[u]) return -1;
        for (int i = 0; i < lg; i++)
            if (k >> i & 1) u = up[i][u];
        return u;
    }
};
endsnippet

snippet WeightedLCA "LCA + weighted path distance via binary lifting" b
struct WeightedLCA {
    int n, lg;
    vector<vector<pair<int, int>>> adj;
    vector<vector<int>> up;
    vector<int> depth, dr;

    WeightedLCA(int n) : n(n), lg(__lg(max(n, 1LL)) + 1), adj(n), up(lg, vector<int>(n)), depth(n), dr(n) {}

    void addEdge(int u, int v, int w) {
        adj[u].push_back({v, w});
        adj[v].push_back({u, w});
    }

    void init(int root = 0) {
        up[0][root] = root;
        vector<int> stk = {root};
        while (!stk.empty()) {
            int u = stk.back(); stk.pop_back();
            for (auto [v, w] : adj[u])
                if (v != up[0][u]) {
                    up[0][v] = u;
                    depth[v] = depth[u] + 1;
                    dr[v] = dr[u] + w;
                    stk.push_back(v);
                }
        }
        for (int i = 1; i < lg; i++)
            for (int v = 0; v < n; v++) up[i][v] = up[i - 1][up[i - 1][v]];
    }

    int lca(int u, int v) {
        if (depth[u] < depth[v]) swap(u, v);
        for (int i = lg - 1; i >= 0; i--)
            if (depth[u] - (1 << i) >= depth[v]) u = up[i][u];
        if (u == v) return u;
        for (int i = lg - 1; i >= 0; i--)
            if (up[i][u] != up[i][v]) u = up[i][u], v = up[i][v];
        return up[0][u];
    }

    int dist(int u, int v) { return dr[u] + dr[v] - 2 * dr[lca(u, v)]; }
};
endsnippet

snippet SCC "Tarjan's strongly connected components, iterative" b
struct SCC {
    int n, timer = 0, sccCount = 0;
    vector<vector<int>> adj;
    vector<int> disc, low, comp, it, stk;

    SCC(int n) : n(n), adj(n), disc(n, -1), low(n), comp(n, -1), it(n) {}

    void addEdge(int u, int v) { adj[u].push_back(v); }

    void run() {
        for (int i = 0; i < n; i++)
            if (disc[i] == -1) dfs(i);
    }

    void dfs(int s) {
        vector<int> calls = {s};
        disc[s] = low[s] = timer++;
        stk.push_back(s);
        while (!calls.empty()) {
            int u = calls.back();
            if (it[u] < (int)adj[u].size()) {
                int v = adj[u][it[u]++];
                if (disc[v] == -1) {
                    disc[v] = low[v] = timer++;
                    stk.push_back(v);
                    calls.push_back(v);
                } else if (comp[v] == -1) low[u] = min(low[u], disc[v]);
            } else {
                calls.pop_back();
                if (!calls.empty()) low[calls.back()] = min(low[calls.back()], low[u]);
                if (low[u] != disc[u]) continue;
                int x;
                do {
                    x = stk.back();
                    stk.pop_back();
                    comp[x] = sccCount;
                } while (x != u);
                sccCount++;
            }
        }
    }
};
endsnippet

snippet Bridges "bridges + articulation points in one DFS" b
struct BridgesArticulation {
    int n, timer = 0, edgeCount = 0;
    vector<vector<pair<int, int>>> adj;
    vector<int> disc, low, it, parentEdge;
    vector<bool> isArt;
    vector<pair<int, int>> bridges;

    BridgesArticulation(int n) : n(n), adj(n), disc(n, -1), low(n), it(n), parentEdge(n, -1), isArt(n) {}

    void addEdge(int u, int v) {
        adj[u].push_back({v, edgeCount});
        adj[v].push_back({u, edgeCount++});
    }

    void run() {
        for (int i = 0; i < n; i++)
            if (disc[i] == -1) dfs(i);
    }

    void dfs(int s) {
        vector<int> stk = {s};
        int rootChildren = 0;
        disc[s] = low[s] = timer++;
        while (!stk.empty()) {
            int u = stk.back();
            if (it[u] < (int)adj[u].size()) {
                auto [v, id] = adj[u][it[u]++];
                if (id == parentEdge[u]) continue;
                if (disc[v] == -1) {
                    disc[v] = low[v] = timer++;
                    parentEdge[v] = id;
                    stk.push_back(v);
                } else low[u] = min(low[u], disc[v]);
            } else {
                stk.pop_back();
                if (stk.empty()) break;
                int p = stk.back();
                low[p] = min(low[p], low[u]);
                if (low[u] > disc[p]) bridges.push_back({p, u});
                if (low[u] >= disc[p]) {
                    if (p == s) rootChildren++;
                    else isArt[p] = true;
                }
            }
        }
        if (rootChildren > 1) isArt[s] = true;
    }
};
endsnippet

snippet TopoSort "topological sort, Kahn's algorithm" b
vector<int> topoSort(int n, const vector<vector<int>> &adj) {
    vector<int> indeg(n), order;
    for (int u = 0; u < n; u++)
        for (int v : adj[u]) indeg[v]++;
    for (int i = 0; i < n; i++)
        if (!indeg[i]) order.push_back(i);
    for (int i = 0; i < (int)order.size(); i++)
        for (int v : adj[order[i]])
            if (--indeg[v] == 0) order.push_back(v);
    return (int)order.size() == n ? order : vector<int>{};
}
endsnippet

snippet HLD "heavy-light decomposition for path queries" b
struct HLD {
    int n, root;
    vector<vector<int>> adj;
    vector<int> parent, depth, heavy, headOf, pos, subSize;

    HLD(int n, int root = 0) : n(n), root(root), adj(n), parent(n, -1), depth(n), heavy(n, -1), headOf(n), pos(n), subSize(n, 1) {}

    void addEdge(int u, int v) {
        adj[u].push_back(v);
        adj[v].push_back(u);
    }

    void build() {
        vector<int> order = {root};
        for (int i = 0; i < (int)order.size(); i++) {
            int u = order[i];
            for (int v : adj[u])
                if (v != parent[u]) parent[v] = u, depth[v] = depth[u] + 1, order.push_back(v);
        }
        for (int i = (int)order.size() - 1; i >= 0; i--) {
            int u = order[i];
            for (int v : adj[u])
                if (v != parent[u]) {
                    subSize[u] += subSize[v];
                    if (heavy[u] == -1 || subSize[v] > subSize[heavy[u]]) heavy[u] = v;
                }
        }
        int timer = 0;
        vector<pair<int, int>> stk = {{root, root}};
        while (!stk.empty()) {
            auto [u, h] = stk.back();
            stk.pop_back();
            headOf[u] = h;
            pos[u] = timer++;
            for (int v : adj[u])
                if (v != parent[u] && v != heavy[u]) stk.push_back({v, v});
            if (heavy[u] != -1) stk.push_back({heavy[u], h});
        }
    }

    int lca(int u, int v) {
        while (headOf[u] != headOf[v]) {
            if (depth[headOf[u]] < depth[headOf[v]]) swap(u, v);
            u = parent[headOf[u]];
        }
        return depth[u] < depth[v] ? u : v;
    }

    void process(int u, int v, function<void(int, int)> op) {
        while (headOf[u] != headOf[v]) {
            if (depth[headOf[u]] < depth[headOf[v]]) swap(u, v);
            op(pos[headOf[u]], pos[u]);
            u = parent[headOf[u]];
        }
        op(min(pos[u], pos[v]), max(pos[u], pos[v]));
    }
};
endsnippet

snippet Centroid "centroid decomposition of a tree" b
struct CentroidDecomposition {
    int n;
    vector<vector<int>> adj;
    vector<int> subSize, par, centroidParent, order;
    vector<bool> removed;

    CentroidDecomposition(int n) : n(n), adj(n), subSize(n), par(n), centroidParent(n, -1), removed(n) {}

    void addEdge(int u, int v) {
        adj[u].push_back(v);
        adj[v].push_back(u);
    }

    void build() { decompose(0, -1); }

    void decompose(int start, int centroidPar) {
        order = {start};
        par[start] = -1;
        for (int i = 0; i < (int)order.size(); i++) {
            int u = order[i];
            subSize[u] = 1;
            for (int v : adj[u])
                if (!removed[v] && v != par[u]) par[v] = u, order.push_back(v);
        }
        int total = order.size(), c = start;
        for (int i = total - 1; i > 0; i--) subSize[par[order[i]]] += subSize[order[i]];
        for (bool moved = true; moved;) {
            moved = false;
            for (int v : adj[c])
                if (!removed[v] && v != par[c] && 2 * subSize[v] > total) {
                    c = v, moved = true;
                    break;
                }
        }
        centroidParent[c] = centroidPar;
        removed[c] = true;
        for (int v : adj[c])
            if (!removed[v]) decompose(v, c);
    }
};
endsnippet

snippet Dinic "max flow, Dinic's algorithm" b
struct Dinic {
    struct Edge { int to, cap, flow = 0; };
    int n;
    vector<Edge> edges;
    vector<vector<int>> adj;
    vector<int> level, it;

    Dinic(int n) : n(n), adj(n) {}

    void addEdge(int u, int v, int cap, int rcap = 0) {
        adj[u].push_back(edges.size());
        edges.push_back({v, cap});
        adj[v].push_back(edges.size());
        edges.push_back({u, rcap});
    }

    bool bfs(int s, int t) {
        level.assign(n, -1);
        level[s] = 0;
        queue<int> q({s});
        while (!q.empty()) {
            int u = q.front();
            q.pop();
            for (int id : adj[u]) {
                auto &e = edges[id];
                if (level[e.to] == -1 && e.cap > e.flow) level[e.to] = level[u] + 1, q.push(e.to);
            }
        }
        return level[t] != -1;
    }

    int dfs(int u, int t, int f) {
        if (u == t) return f;
        int pushed = 0;
        for (int &i = it[u]; i < (int)adj[u].size(); i++) {
            int id = adj[u][i];
            auto &e = edges[id];
            if (level[e.to] != level[u] + 1 || e.cap == e.flow) continue;
            int d = dfs(e.to, t, min(f - pushed, e.cap - e.flow));
            e.flow += d, edges[id ^ 1].flow -= d, pushed += d;
            if (pushed == f) break;
        }
        return pushed;
    }

    int maxflow(int s, int t) {
        int flow = 0;
        while (bfs(s, t)) {
            it.assign(n, 0);
            flow += dfs(s, t, inf);
        }
        return flow;
    }
};
endsnippet

snippet ZFunction "Z-function + pattern occurrences" b
struct ZFunction {
    vector<int> z;

    ZFunction(const string &s) : z(s.size()) {
        int n = s.size();
        for (int i = 1, l = 0, r = 0; i < n; i++) {
            if (i < r) z[i] = min(r - i, z[i - l]);
            while (i + z[i] < n && s[z[i]] == s[i + z[i]]) z[i]++;
            if (i + z[i] > r) l = i, r = i + z[i];
        }
    }

    static vector<int> findOccurrences(const string &pattern, const string &text) {
        ZFunction zf(pattern + '\\1' + text);
        int m = pattern.size();
        vector<int> occ;
        for (int i = m + 1; i < (int)zf.z.size(); i++)
            if (zf.z[i] >= m) occ.push_back(i - m - 1);
        return occ;
    }
};
endsnippet

snippet KMP "prefix-function string matching" b
struct KMP {
    string pat;
    vector<int> pi;

    KMP(const string &pat) : pat(pat), pi(pat.size()) {
        for (int i = 1; i < (int)pat.size(); i++) {
            int j = pi[i - 1];
            while (j && pat[i] != pat[j]) j = pi[j - 1];
            pi[i] = j + (pat[i] == pat[j]);
        }
    }

    vector<int> match(const string &text) const {
        vector<int> occ;
        int m = pat.size(), j = 0;
        for (int i = 0; i < (int)text.size(); i++) {
            while (j && text[i] != pat[j]) j = pi[j - 1];
            j += text[i] == pat[j];
            if (j == m) { occ.push_back(i - m + 1); j = pi[j - 1]; }
        }
        return occ;
    }
};
endsnippet

snippet SuffixArray "O(n log n) suffix array + Kasai's LCP" b
struct SuffixArray {
    int n;
    vector<int> sa, rnk, lcp;

    SuffixArray(const string &s) : n(s.size()), sa(n), rnk(n), lcp(n) {
        int m = 256;
        vector<int> x(n), y(n), c(max(m, n) + 1);
        for (int i = 0; i < n; i++) c[x[i] = (unsigned char)s[i]]++;
        partial_sum(c.begin(), c.begin() + m, c.begin());
        for (int i = n - 1; i >= 0; i--) sa[--c[x[i]]] = i;
        for (int k = 1; k < n; k <<= 1) {
            int p = 0;
            for (int i = n - k; i < n; i++) y[p++] = i;
            for (int i = 0; i < n; i++) if (sa[i] >= k) y[p++] = sa[i] - k;
            fill(c.begin(), c.begin() + m, 0);
            for (int i = 0; i < n; i++) c[x[i]]++;
            partial_sum(c.begin(), c.begin() + m, c.begin());
            for (int i = n - 1; i >= 0; i--) sa[--c[x[y[i]]]] = y[i];
            swap(x, y);
            auto second = [&](int i) { return i + k < n ? y[i + k] : -1; };
            p = 1;
            x[sa[0]] = 0;
            for (int i = 1; i < n; i++) {
                int a = sa[i - 1], b = sa[i];
                x[b] = y[a] == y[b] && second(a) == second(b) ? p - 1 : p++;
            }
            if (p >= n) break;
            m = p;
        }
        for (int i = 0; i < n; i++) rnk[sa[i]] = i;
        for (int i = 0, h = 0; i < n; i++) {
            if (rnk[i] == 0) { h = 0; continue; }
            int j = sa[rnk[i] - 1];
            while (i + h < n && j + h < n && s[i + h] == s[j + h]) h++;
            lcp[rnk[i]] = h;
            if (h) h--;
        }
    }
};
endsnippet

snippet AhoCorasick "multi-pattern string matching automaton" b
struct AhoCorasick {
    static constexpr int ALPHA = 26, BASE = 'a';
    struct Node {
        array<int, ALPHA> next;
        int fail = 0, cnt = 0;
        Node() { next.fill(-1); }
    };
    vector<Node> t;

    AhoCorasick() : t(1) {}

    void addPattern(const string &s) {
        int cur = 0;
        for (char c : s) {
            int &nx = t[cur].next[c - BASE];
            if (nx == -1) { nx = t.size(); t.emplace_back(); }
            cur = t[cur].next[c - BASE];
        }
        t[cur].cnt++;
    }

    void build() {
        queue<int> q;
        q.push(0);
        while (!q.empty()) {
            int u = q.front(); q.pop();
            if (u) t[u].cnt += t[t[u].fail].cnt;
            for (int c = 0; c < ALPHA; c++) {
                int v = t[u].next[c], f = u ? t[t[u].fail].next[c] : 0;
                if (v == -1) t[u].next[c] = f;
                else { t[v].fail = f; q.push(v); }
            }
        }
    }

    int countMatches(const string &text) const {
        int total = 0, cur = 0;
        for (char c : text) { cur = t[cur].next[c - BASE]; total += t[cur].cnt; }
        return total;
    }
};
endsnippet

snippet PolyHash "anti-hash-test-safe polynomial hash, string or array" b
struct PolyHash {
    static constexpr uint64_t MOD = (1ULL << 61) - 1;
    uint64_t base;
    vector<uint64_t> pw, pre;

    static uint64_t mulmod(uint64_t a, uint64_t b) {
        __uint128_t p = (__uint128_t)a * b;
        uint64_t r = (uint64_t)(p & MOD) + (uint64_t)(p >> 61);
        return r >= MOD ? r - MOD : r;
    }

    template<typename T>
    PolyHash(const vector<T> &a) : pw(a.size() + 1, 1), pre(a.size() + 1) {
        static mt19937_64 rng(chrono::steady_clock::now().time_since_epoch().count());
        base = rng() % (MOD - 256) + 256;
        for (int i = 0; i < (int)a.size(); i++) {
            int64_t v = (int64_t)a[i] % (int64_t)(MOD - 1);
            if (v < 0) v += MOD - 1;
            pw[i + 1] = mulmod(pw[i], base);
            pre[i + 1] = (mulmod(pre[i], base) + v + 1) % MOD;
        }
    }
    PolyHash(const string &s) : PolyHash(vector<int>(s.begin(), s.end())) {}

    uint64_t get(int l, int r) const {
        return (pre[r + 1] + MOD - mulmod(pw[r - l + 1], pre[l])) % MOD;
    }

    uint64_t combine(uint64_t leftHash, uint64_t rightHash, int rightLen) const {
        return (mulmod(leftHash, pw[rightLen]) + rightHash) % MOD;
    }
};
endsnippet

snippet Trie "array trie: insert/erase, count words and prefixes" b
struct Trie {
    static constexpr int ALPHA = 26, BASE = 'a';
    vector<array<int, ALPHA>> nx;
    vector<int> pass, ends;

    Trie() { newNode(); }

    int newNode() {
        nx.emplace_back();
        nx.back().fill(0);
        pass.push_back(0);
        ends.push_back(0);
        return nx.size() - 1;
    }

    int walk(const string &s) {
        int cur = 0;
        for (char c : s) if (!(cur = nx[cur][c - BASE])) return -1;
        return cur;
    }

    void insert(const string &s) {
        int cur = 0;
        pass[0]++;
        for (char c : s) {
            if (!nx[cur][c - BASE]) { int v = newNode(); nx[cur][c - BASE] = v; }
            cur = nx[cur][c - BASE];
            pass[cur]++;
        }
        ends[cur]++;
    }

    bool search(const string &s) { int v = walk(s); return v >= 0 && ends[v] > 0; }
    bool startsWith(const string &s) { int v = walk(s); return v >= 0 && pass[v] > 0; }

    bool remove(const string &s) {
        if (!search(s)) return false;
        int cur = 0;
        pass[0]--;
        for (char c : s) { cur = nx[cur][c - BASE]; pass[cur]--; }
        ends[cur]--;
        return true;
    }
};
endsnippet

snippet ModInt "modular integer type with operators" b
template <int MOD = 998244353>
struct Modular {
    int value;
    Modular(long long v = 0) : value((v % MOD + MOD) % MOD) {}

    Modular &operator+=(const Modular &b) { value += b.value; if (value >= MOD) value -= MOD; return *this; }
    Modular &operator-=(const Modular &b) { value -= b.value; if (value < 0) value += MOD; return *this; }
    Modular &operator*=(const Modular &b) { value = value * b.value % MOD; return *this; }
    Modular &operator/=(const Modular &b) { return *this *= inverse(b); }

    friend Modular power(Modular a, long long e) {
        Modular r = 1;
        for (; e; e >>= 1, a *= a) if (e & 1) r *= a;
        return r;
    }
    friend Modular inverse(Modular a) { return power(a, MOD - 2); }
    friend Modular operator+(Modular a, const Modular &b) { return a += b; }
    friend Modular operator-(Modular a, const Modular &b) { return a -= b; }
    friend Modular operator*(Modular a, const Modular &b) { return a *= b; }
    friend Modular operator/(Modular a, const Modular &b) { return a /= b; }
    friend Modular operator-(const Modular &a) { return 0 - a; }
    friend bool operator==(const Modular &a, const Modular &b) { return a.value == b.value; }
    friend bool operator!=(const Modular &a, const Modular &b) { return a.value != b.value; }
    friend ostream &operator<<(ostream &os, const Modular &a) { return os << a.value; }
    friend istream &operator>>(istream &is, Modular &a) { long long v; is >> v; a = Modular(v); return is; }
};

using mint = Modular<998244353>;
endsnippet

snippet Comb "nCr/nPr, custom max-N (see also existing nCr)" b
struct Combinatorics {
    int n;
    vector<int> fac, inv, finv;

    Combinatorics(int n) : n(n), fac(n + 2), inv(n + 2), finv(n + 2) {
        fac[0] = inv[1] = finv[0] = 1;
        for (int i = 1; i <= n; i++) fac[i] = fac[i - 1] * i % mod;
        for (int i = 2; i <= n; i++) inv[i] = (mod - mod / i * inv[mod % i] % mod) % mod;
        for (int i = 1; i <= n; i++) finv[i] = finv[i - 1] * inv[i] % mod;
    }

    int nCr(int a, int b) {
        if (b < 0 || b > a) return 0;
        return fac[a] * finv[b] % mod * finv[a - b] % mod;
    }

    int nPr(int a, int b) {
        if (b < 0 || b > a) return 0;
        return fac[a] * finv[a - b] % mod;
    }
};
endsnippet

snippet CRT "Chinese Remainder Theorem" b
tuple<int, int, int> extGcd(int a, int b) {
    if (!b) return {a, 1, 0};
    auto [g, x, y] = extGcd(b, a % b);
    return {g, y, x - a / b * y};
}

pair<int, int> crt(int a, int m, int b, int n) {
    auto [g, p, q] = extGcd(m, n);
    assert((a - b) % g == 0);
    int l = n / g;
    a = (a % m + m) % m;
    int k = ((b - a) / g % l + l) % l * ((p % l + l) % l) % l;
    return {a + m * k, m / g * n};
}
endsnippet

snippet Totient "Euler's totient of a single value" b
int phi(int n) {
    int result = n;
    for (int p = 2; p * p <= n; p++)
        if (n % p == 0) {
            while (n % p == 0) n /= p;
            result -= result / p;
        }
    if (n > 1) result -= result / n;
    return result;
}
endsnippet

snippet FastPow "binary exponentiation + inverse, runtime modulus" b
namespace FastPow {
using ull = unsigned long long;

ull mulmod(ull a, ull b, ull m) { return (__uint128_t)a * b % m; }

ull power(ull b, ull e, ull m) {
    ull ans = 1 % m;
    for (b %= m; e; e >>= 1, b = mulmod(b, b, m))
        if (e & 1) ans = mulmod(ans, b, m);
    return ans;
}

ull inverse(ull n, ull m) {
    long long a = n % m, b = m, x = 1, y = 0;
    while (b) {
        long long t = a / b;
        a -= t * b, swap(a, b);
        x -= t * y, swap(x, y);
    }
    return (x % (long long)m + m) % m;
}
}
endsnippet

snippet NTT "polynomial multiplication mod 998244353" b
namespace NTT {
constexpr int MOD = 998244353, ROOT = 3;

int power(int a, int e) {
    int r = 1;
    for (; e; e >>= 1, a = a * a % MOD) if (e & 1) r = r * a % MOD;
    return r;
}

void ntt(vector<int> &a, bool invert) {
    int n = a.size();
    for (int i = 1, j = 0; i < n; i++) {
        int bit = n >> 1;
        for (; j & bit; bit >>= 1) j ^= bit;
        j ^= bit;
        if (i < j) swap(a[i], a[j]);
    }
    for (int len = 2; len <= n; len <<= 1) {
        int w = power(ROOT, (MOD - 1) / len);
        if (invert) w = power(w, MOD - 2);
        for (int i = 0; i < n; i += len) {
            int wn = 1;
            for (int j = 0; j < len / 2; j++, wn = wn * w % MOD) {
                int u = a[i + j], v = a[i + j + len / 2] * wn % MOD;
                a[i + j] = u + v < MOD ? u + v : u + v - MOD;
                a[i + j + len / 2] = u >= v ? u - v : u - v + MOD;
            }
        }
    }
    if (invert) {
        int nInv = power(n, MOD - 2);
        for (int &x : a) x = x * nInv % MOD;
    }
}

vector<int> multiply(vector<int> a, vector<int> b) {
    if (a.empty() || b.empty()) return {};
    int size = a.size() + b.size() - 1, n = 1;
    while (n < size) n <<= 1;
    a.resize(n), b.resize(n);
    ntt(a, false), ntt(b, false);
    for (int i = 0; i < n; i++) a[i] = a[i] * b[i] % MOD;
    ntt(a, true);
    a.resize(size);
    return a;
}
}
endsnippet

snippet Sieve "linear sieve, primality + factorization" b
struct Sieve {
    vector<int32_t> spf, primes;

    Sieve(int n) : spf(n + 1) {
        for (int i = 2; i <= n; i++) {
            if (!spf[i]) spf[i] = i, primes.push_back(i);
            for (int p : primes) {
                if (p > spf[i] || p * i > n) break;
                spf[p * i] = p;
            }
        }
    }

    bool isPrime(int x) const { return x >= 2 && spf[x] == x; }

    vector<int32_t> factorize(int x) const {
        vector<int32_t> f;
        for (; x > 1; x /= f.back()) f.push_back(spf[x]);
        return f;
    }
};
endsnippet

snippet SegTree "iterative point-update range-query, generic op" b
template<typename T, typename F>
struct SegTree {
    int n;
    vector<T> t;
    T id;
    F combine;

    SegTree(const vector<T> &a, T id, F combine) : n(a.size()), t(2 * n, id), id(id), combine(combine) {
        for (int i = 0; i < n; i++) t[i + n] = a[i];
        for (int i = n - 1; i > 0; i--) t[i] = combine(t[2 * i], t[2 * i + 1]);
    }

    void update(int i, T val) {
        for (t[i += n] = val; i > 1; i >>= 1) t[i >> 1] = combine(t[i & ~1], t[i | 1]);
    }

    T query(int l, int r) {
        T resl = id, resr = id;
        for (l += n, r += n + 1; l < r; l >>= 1, r >>= 1) {
            if (l & 1) resl = combine(resl, t[l++]);
            if (r & 1) resr = combine(t[--r], resr);
        }
        return combine(resl, resr);
    }
};
endsnippet

snippet LazySegTree "range-update range-query, generic op" b
struct LazySegTree {
    struct Node { int mn = 0, mx = 0, sum = 0, lazy = 0; };
    int n;
    vector<Node> t;

    LazySegTree(int n) : n(n), t(4 * n) {}

    static Node pull(const Node &a, const Node &b) { return {min(a.mn, b.mn), max(a.mx, b.mx), a.sum + b.sum, 0}; }

    void apply(int p, int l, int r, int v) {
        t[p].mn += v; t[p].mx += v; t[p].sum += v * (r - l + 1); t[p].lazy += v;
    }

    void push(int p, int l, int r) {
        int m = (l + r) / 2;
        apply(2 * p, l, m, t[p].lazy);
        apply(2 * p + 1, m + 1, r, t[p].lazy);
        t[p].lazy = 0;
    }

    void range_add(int p, int l, int r, int L, int R, int v) {
        if (R < l || r < L) return;
        if (L <= l && r <= R) return apply(p, l, r, v);
        push(p, l, r);
        int m = (l + r) / 2;
        range_add(2 * p, l, m, L, R, v);
        range_add(2 * p + 1, m + 1, r, L, R, v);
        t[p] = pull(t[2 * p], t[2 * p + 1]);
    }

    Node query(int p, int l, int r, int L, int R) {
        if (R < l || r < L) return {inf, -inf, 0, 0};
        if (L <= l && r <= R) return t[p];
        push(p, l, r);
        int m = (l + r) / 2;
        return pull(query(2 * p, l, m, L, R), query(2 * p + 1, m + 1, r, L, R));
    }

    void Add(int L, int R, int v) { range_add(1, 1, n, L, R, v); }
    int Min(int L, int R) { return query(1, 1, n, L, R).mn; }
    int Max(int L, int R) { return query(1, 1, n, L, R).mx; }
    int Sum(int L, int R) { return query(1, 1, n, L, R).sum; }
};
endsnippet

snippet PersistentSegTree "versioned segment tree" b
template<typename T, typename F>
struct PersistentSegTree {
    struct Node { T val; int l, r; };
    vector<Node> t;
    vector<int> roots;
    int n;
    T id;
    F combine;

    PersistentSegTree(const vector<T> &a, T id, F combine) : n(a.size()), id(id), combine(combine) {
        roots.push_back(build(a, 0, n - 1));
    }

    int add(T val, int l, int r) {
        t.push_back({val, l, r});
        return t.size() - 1;
    }

    int build(const vector<T> &a, int l, int r) {
        if (l == r) return add(a[l], -1, -1);
        int m = (l + r) / 2;
        int lc = build(a, l, m), rc = build(a, m + 1, r);
        return add(combine(t[lc].val, t[rc].val), lc, rc);
    }

    int update_(int p, int l, int r, int i, T val) {
        if (l == r) return add(val, -1, -1);
        int m = (l + r) / 2, lc = t[p].l, rc = t[p].r;
        if (i <= m) lc = update_(lc, l, m, i, val);
        else rc = update_(rc, m + 1, r, i, val);
        return add(combine(t[lc].val, t[rc].val), lc, rc);
    }

    int update(int version, int i, T val) {
        roots.push_back(update_(roots[version], 0, n - 1, i, val));
        return roots.size() - 1;
    }

    T query_(int p, int l, int r, int ql, int qr) {
        if (qr < l || r < ql) return id;
        if (ql <= l && r <= qr) return t[p].val;
        int m = (l + r) / 2;
        return combine(query_(t[p].l, l, m, ql, qr), query_(t[p].r, m + 1, r, ql, qr));
    }

    T query(int version, int l, int r) { return query_(roots[version], 0, n - 1, l, r); }
};
endsnippet

snippet MergeSortTree "count-less-than / order-stat range queries" b
struct MergeSortTree {
    int n;
    vector<vector<int>> t;

    MergeSortTree(const vector<int> &a) : n(a.size()), t(4 * n) { build(a, 1, 0, n - 1); }

    void build(const vector<int> &a, int p, int l, int r) {
        if (l == r) { t[p] = {a[l]}; return; }
        int m = (l + r) / 2;
        build(a, 2 * p, l, m);
        build(a, 2 * p + 1, m + 1, r);
        merge(all(t[2 * p]), all(t[2 * p + 1]), back_inserter(t[p]));
    }

    template<typename G>
    void visit(int p, int l, int r, int ql, int qr, G &g) {
        if (qr < l || r < ql) return;
        if (ql <= l && r <= qr) return g(t[p]);
        int m = (l + r) / 2;
        visit(2 * p, l, m, ql, qr, g);
        visit(2 * p + 1, m + 1, r, ql, qr, g);
    }

    int countLess(int l, int r, int x) {
        int res = 0;
        auto g = [&](vector<int> &v) { res += lower_bound(all(v), x) - v.begin(); };
        visit(1, 0, n - 1, l, r, g);
        return res;
    }

    int predecessor(int l, int r, int x) {
        int res = -inf;
        auto g = [&](vector<int> &v) {
            auto it = upper_bound(all(v), x);
            if (it != v.begin()) res = max(res, *prev(it));
        };
        visit(1, 0, n - 1, l, r, g);
        return res;
    }

    int successor(int l, int r, int x) {
        int res = inf;
        auto g = [&](vector<int> &v) {
            auto it = lower_bound(all(v), x);
            if (it != v.end()) res = min(res, *it);
        };
        visit(1, 0, n - 1, l, r, g);
        return res;
    }
};
endsnippet

snippet MaxSubarraySeg "max-subarray-sum segment tree" b
struct MaxSubarraySegTree {
    struct Node { int pref, suf, best, sum; };
    int n;
    vector<Node> t;

    static Node merge(const Node &a, const Node &b) {
        return {max(a.pref, a.sum + b.pref), max(b.suf, b.sum + a.suf),
                max({a.best, b.best, a.suf + b.pref}), a.sum + b.sum};
    }

    MaxSubarraySegTree(const vector<int> &a) : n(a.size()), t(2 * n) {
        for (int i = 0; i < n; i++) t[i + n] = {a[i], a[i], a[i], a[i]};
        for (int i = n - 1; i > 0; i--) t[i] = merge(t[2 * i], t[2 * i + 1]);
    }

    void update(int i, int val) {
        for (t[i += n] = {val, val, val, val}; i > 1; i >>= 1) t[i >> 1] = merge(t[i & ~1], t[i | 1]);
    }

    int query(int l, int r) {
        Node resl = {-inf, -inf, -inf, 0}, resr = resl;
        for (l += n, r += n + 1; l < r; l >>= 1, r >>= 1) {
            if (l & 1) resl = merge(resl, t[l++]);
            if (r & 1) resr = merge(t[--r], resr);
        }
        return merge(resl, resr).best;
    }
};
endsnippet

snippet RangeToggleSum "range XOR-toggle + range sum" b
struct ToggleSegTree {
    int n;
    vector<int> sum, flip;

    ToggleSegTree(int n) : n(n), sum(4 * n), flip(4 * n) {}

    void apply(int p, int l, int r) {
        sum[p] = r - l + 1 - sum[p];
        flip[p] ^= 1;
    }

    void push(int p, int l, int r) {
        if (!flip[p]) return;
        int m = (l + r) / 2;
        apply(2 * p, l, m);
        apply(2 * p + 1, m + 1, r);
        flip[p] = 0;
    }

    void upd(int p, int l, int r, int L, int R) {
        if (R < l || r < L) return;
        if (L <= l && r <= R) return apply(p, l, r);
        push(p, l, r);
        int m = (l + r) / 2;
        upd(2 * p, l, m, L, R);
        upd(2 * p + 1, m + 1, r, L, R);
        sum[p] = sum[2 * p] + sum[2 * p + 1];
    }

    int qry(int p, int l, int r, int L, int R) {
        if (R < l || r < L) return 0;
        if (L <= l && r <= R) return sum[p];
        push(p, l, r);
        int m = (l + r) / 2;
        return qry(2 * p, l, m, L, R) + qry(2 * p + 1, m + 1, r, L, R);
    }

    void toggle(int l, int r) { upd(1, 0, n - 1, l, r); }
    int query(int l, int r) { return qry(1, 0, n - 1, l, r); }
};
endsnippet

snippet Fenwick "point-update range-sum + binary search" b
struct Fenwick {
    int n;
    vector<int> t;

    Fenwick(int n) : n(n), t(n + 1) {}

    void update(int idx, int val) {
        for (++idx; idx <= n; idx += idx & -idx) t[idx] += val;
    }

    int query(int idx) {
        int s = 0;
        for (++idx; idx > 0; idx -= idx & -idx) s += t[idx];
        return s;
    }

    int query(int l, int r) { return query(r) - query(l - 1); }

    int lower_bound(int val) {
        int pos = 0;
        for (int pw = bit_floor((unsigned long long)n); pw; pw >>= 1)
            if (pos + pw <= n && t[pos + pw] < val) pos += pw, val -= t[pos];
        return pos;
    }
};
endsnippet

snippet FenwickRUPQ "range-update point-query BIT" b
struct FenwickRUPQ {
    int n;
    vector<int> t;

    FenwickRUPQ(int n) : n(n), t(n + 1) {}

    void add(int idx, int val) {
        for (++idx; idx <= n; idx += idx & -idx) t[idx] += val;
    }

    void update(int l, int r, int val) { add(l, val), add(r + 1, -val); }

    int query(int idx) {
        int s = 0;
        for (++idx; idx > 0; idx -= idx & -idx) s += t[idx];
        return s;
    }
};
endsnippet

snippet FenwickRURQ "range-update range-query BIT (two-BIT trick)" b
struct FenwickRURQ {
    int n;
    vector<int> t1, t2;

    FenwickRURQ(int n) : n(n), t1(n + 1), t2(n + 1) {}

    void add(int i, int val) {
        for (int j = i; j <= n; j += j & -j) t1[j] += val, t2[j] += val * i;
    }

    void update(int l, int r, int val) { add(l + 1, val), add(r + 2, -val); }

    int prefix(int k) {
        int s1 = 0, s2 = 0;
        for (int i = k + 1; i > 0; i -= i & -i) s1 += t1[i], s2 += t2[i];
        return (k + 2) * s1 - s2;
    }

    int query(int l, int r) { return prefix(r) - prefix(l - 1); }
};
endsnippet

snippet Fenwick2D "2D point-update rectangle-sum-query" b
struct Fenwick2D {
    int n, m;
    vector<vector<int>> t;

    Fenwick2D(int n, int m) : n(n), m(m), t(n + 1, vector<int>(m + 1)) {}

    void update(int x, int y, int val) {
        for (int i = x + 1; i <= n; i += i & -i)
            for (int j = y + 1; j <= m; j += j & -j) t[i][j] += val;
    }

    int query(int x, int y) {
        int s = 0;
        for (int i = x + 1; i > 0; i -= i & -i)
            for (int j = y + 1; j > 0; j -= j & -j) s += t[i][j];
        return s;
    }

    int query(int x1, int y1, int x2, int y2) {
        return query(x2, y2) - query(x1 - 1, y2) - query(x2, y1 - 1) + query(x1 - 1, y1 - 1);
    }
};
endsnippet

snippet SparseTable "O(1) RMQ, generic idempotent op (min/max/gcd)" b
template<typename T, typename F>
struct SparseTable {
    vector<vector<T>> sp;
    F combine;

    SparseTable(const vector<T> &a, F combine) : sp(1, a), combine(combine) {
        int n = a.size();
        for (int j = 1; (1 << j) <= n; j++) {
            sp.emplace_back(n - (1 << j) + 1);
            for (int i = 0; i + (1 << j) <= n; i++)
                sp[j][i] = combine(sp[j - 1][i], sp[j - 1][i + (1 << (j - 1))]);
        }
    }

    T query(int l, int r) {
        int k = __lg(r - l + 1);
        return combine(sp[k][l], sp[k][r - (1 << k) + 1]);
    }
};
endsnippet

snippet RMQ2D "2D range min/max query" b
template<typename T, typename F>
struct SparseTable2D {
    int n, m;
    vector<vector<vector<vector<T>>>> st;
    F combine;

    SparseTable2D(const vector<vector<T>> &a, F combine) : n(a.size()), m(a[0].size()), combine(combine) {
        st.assign(__lg(n) + 1, vector<vector<vector<T>>>(__lg(m) + 1, a));
        for (int kx = 0; kx < (int)st.size(); kx++)
            for (int ky = 0; ky < (int)st[kx].size(); ky++) {
                if (!kx && !ky) continue;
                for (int i = 0; i + (1 << kx) <= n; i++)
                    for (int j = 0; j + (1 << ky) <= m; j++)
                        st[kx][ky][i][j] = kx
                            ? combine(st[kx - 1][ky][i][j], st[kx - 1][ky][i + (1 << (kx - 1))][j])
                            : combine(st[0][ky - 1][i][j], st[0][ky - 1][i][j + (1 << (ky - 1))]);
            }
    }

    T query(int x1, int y1, int x2, int y2) {
        int kx = __lg(x2 - x1 + 1), ky = __lg(y2 - y1 + 1);
        int nx = x2 - (1 << kx) + 1, ny = y2 - (1 << ky) + 1;
        auto &s = st[kx][ky];
        return combine(combine(s[x1][y1], s[x1][ny]), combine(s[nx][y1], s[nx][ny]));
    }
};
endsnippet

snippet DigitDP "digit-DP skeleton with worked toy example" b
struct DigitDP {
    string digits;
    int K;
    vector<vector<int>> memo;

    DigitDP(int bound, int k) : digits(to_string(bound)), K(k), memo(digits.size(), vector<int>(9 * digits.size() + 1, -1)) {}

    int solve(int pos, bool tight, int sum) {
        if (pos == (int)digits.size()) return sum <= K;
        if (!tight && memo[pos][sum] != -1) return memo[pos][sum];
        int limit = tight ? digits[pos] - '0' : 9, total = 0;
        for (int d = 0; d <= limit; d++) total += solve(pos + 1, tight && d == limit, sum + d);
        return tight ? total : memo[pos][sum] = total;
    }

    int count() { return solve(0, true, 0); }
};
endsnippet

snippet BitmaskDP "bitmask-DP skeleton with worked toy example" b
struct BitmaskDP {
    int n;
    vector<vector<int>> cost;
    vector<int> memo;

    BitmaskDP(vector<vector<int>> c) : n(c.size()), cost(move(c)), memo(1 << n, -1) {}

    int solve(int mask) {
        if (mask == (1 << n) - 1) return 0;
        if (memo[mask] != -1) return memo[mask];
        int worker = __builtin_popcountll(mask), best = inf;
        for (int task = 0; task < n; task++)
            if (!(mask >> task & 1)) best = min(best, cost[worker][task] + solve(mask | 1 << task));
        return memo[mask] = best;
    }

    int answer() { return solve(0); }
};
endsnippet

snippet SOSDP "sum-over-subsets DP" b
vector<int> sos(vector<int> f) {
    for (int b = 1; b < (int)f.size(); b <<= 1)
        for (int mask = 0; mask < (int)f.size(); mask++)
            if (mask & b) f[mask] += f[mask ^ b];
    return f;
}
endsnippet

snippet DnCOpt "divide-and-conquer DP optimization" b
template <class Cost>
void solveDnC(vector<int> &cur, const vector<int> &prev, int lo, int hi, int optLo, int optHi, Cost cost) {
    if (lo >= hi) return;
    int mid = (lo + hi) / 2;
    pair<int, int> best = {inf, optLo};
    for (int k = optLo; k <= min(mid - 1, optHi); k++)
        best = min(best, {prev[k] + cost(k, mid), k});
    cur[mid] = best.first;
    solveDnC(cur, prev, lo, mid, optLo, best.second, cost);
    solveDnC(cur, prev, mid + 1, hi, best.second, optHi, cost);
}
endsnippet

snippet KnuthOpt "Knuth's DP optimization" b
template <class Cost>
struct KnuthOpt {
    int n;
    vector<vector<int>> dp, opt;
    Cost cost;

    KnuthOpt(int n, Cost cost) : n(n), dp(n, vector<int>(n)), opt(n, vector<int>(n)), cost(cost) {
        for (int i = 0; i < n; i++) opt[i][i] = i;
        for (int len = 2; len <= n; len++)
            for (int i = 0; i + len <= n; i++) {
                int j = i + len - 1;
                dp[i][j] = inf;
                for (int k = opt[i][j - 1]; k <= min(j - 1, opt[i + 1][j]); k++) {
                    int val = dp[i][k] + dp[k + 1][j] + cost(i, j);
                    if (val < dp[i][j]) dp[i][j] = val, opt[i][j] = k;
                }
            }
    }

    int answer() { return n <= 1 ? 0 : dp[0][n - 1]; }
};
endsnippet

snippet CHT "convex hull trick, max/min line envelope" b
struct Line {
    mutable int k, m, p;
    bool operator<(const Line &o) const { return k < o.k; }
    bool operator<(int x) const { return p < x; }
};

struct LineContainer : multiset<Line, less<>> {
    static int div(int a, int b) { return a / b - ((a ^ b) < 0 && a % b); }

    bool isect(iterator x, iterator y) {
        if (y == end()) { x->p = inf; return false; }
        if (x->k == y->k) x->p = x->m > y->m ? inf : -inf;
        else x->p = div(y->m - x->m, x->k - y->k);
        return x->p >= y->p;
    }

    void add(int k, int m) {
        auto z = insert({k, m, 0}), y = z++, x = y;
        while (isect(y, z)) z = erase(z);
        if (x != begin() && isect(--x, y)) isect(x, y = erase(y));
        while ((y = x) != begin() && (--x)->p >= y->p) isect(x, erase(y));
    }

    int query(int x) {
        auto l = *lower_bound(x);
        return l.k * x + l.m;
    }
};
endsnippet

snippet MinStack "O(1) stack with running minimum" b
struct MinStack {
    vector<pair<int, int>> st;

    void push(int x) { st.push_back({x, st.empty() ? x : min(x, st.back().second)}); }
    void pop() { st.pop_back(); }
    int top() { return st.back().first; }
    int getMin() { return st.back().second; }
    int size() { return st.size(); }
    bool empty() { return st.empty(); }
};
endsnippet

snippet MinDeque "O(1) queue with running minimum (sliding window)" b
struct MinDeque {
    vector<pair<int, int>> l, r;

    static void push(vector<pair<int, int>> &s, int x) { s.push_back({x, s.empty() ? x : min(x, s.back().second)}); }

    static void refill(vector<pair<int, int>> &empty, vector<pair<int, int>> &full) {
        vector<int> v;
        for (auto &p : full) v.push_back(p.first);
        full.clear();
        int k = (v.size() + 1) / 2;
        for (int i = k - 1; i >= 0; i--) push(empty, v[i]);
        for (int i = k; i < (int)v.size(); i++) push(full, v[i]);
    }

    void push_front(int x) { push(l, x); }
    void push_back(int x) { push(r, x); }
    void pop_front() { front(); l.pop_back(); }
    void pop_back() { back(); r.pop_back(); }
    int front() { if (l.empty()) refill(l, r); return l.back().first; }
    int back() { if (r.empty()) refill(r, l); return r.back().first; }
    int getMin() { return l.empty() ? r.back().second : r.empty() ? l.back().second : min(l.back().second, r.back().second); }
    int size() { return l.size() + r.size(); }
    bool empty() { return l.empty() && r.empty(); }
};
endsnippet

snippet PrefixSuffixMex "prefix/suffix mex of an array" b
pair<vector<int>, vector<int>> prefixSuffixMex(const vector<int> &a) {
    int n = a.size();
    auto prefMex = [&](const vector<int> &v) {
        vector<int> res(n);
        vector<char> seen(n + 2);
        for (int i = 0, mex = 0; i < n; i++) {
            if (0 <= v[i] && v[i] <= n) seen[v[i]] = 1;
            while (seen[mex]) mex++;
            res[i] = mex;
        }
        return res;
    };
    vector<int> suf = prefMex(vector<int>(a.rbegin(), a.rend()));
    reverse(all(suf));
    return {prefMex(a), suf};
}
endsnippet

snippet TernarySearch "ternary search on a unimodal integer function" b
template <class F>
int ternarySearchMin(int lo, int hi, F f) {
    while (lo < hi) {
        int mid = lo + (hi - lo) / 2;
        if (f(mid) <= f(mid + 1)) hi = mid;
        else lo = mid + 1;
    }
    return lo;
}
endsnippet

snippet BalMultiset "multiset with lower median and sum of |v - median|" b
struct BalancedMultiset {
    multiset<int> low, high;
    int lowSum = 0, highSum = 0;

    void balance() {
        while (low.size() > high.size() + 1) {
            auto it = prev(low.end());
            lowSum -= *it; highSum += *it;
            high.insert(*it); low.erase(it);
        }
        while (low.size() < high.size()) {
            auto it = high.begin();
            highSum -= *it; lowSum += *it;
            low.insert(*it); high.erase(it);
        }
    }

    void insert(int x) {
        if (!low.empty() && x > *low.rbegin()) high.insert(x), highSum += x;
        else low.insert(x), lowSum += x;
        balance();
    }

    void erase(int x) {
        if (!low.empty() && x <= *low.rbegin()) low.erase(low.find(x)), lowSum -= x;
        else high.erase(high.find(x)), highSum -= x;
        balance();
    }

    int size() { return low.size() + high.size(); }
    int median() { return *low.rbegin(); }

    int query() {
        int m = median();
        return m * (int)low.size() - lowSum + highSum - m * (int)high.size();
    }
};
endsnippet

snippet DivWindow "n/k minus max block frequency over divisor windows" b
int minimumOperationsToMakeKPeriodic(const string &word, int k) {
    unordered_map<string, int> freq;
    int best = 0;
    for (int i = 0; i < (int)word.size(); i += k) best = max(best, ++freq[word.substr(i, k)]);
    return (int)word.size() / k - best;
}
endsnippet
